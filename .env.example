# ------------------------------------------------------------------
# Firebase (client SDK) — usado por apps/backoffice, professional, mobile
# Next.js: prefixe com NEXT_PUBLIC_ | Expo: prefixe com EXPO_PUBLIC_
# ------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ------------------------------------------------------------------
# Billing (Asaas) — configurado como secrets nas Cloud Functions
# firebase functions:secrets:set ASAAS_API_KEY
# firebase functions:secrets:set ASAAS_WEBHOOK_TOKEN
# ------------------------------------------------------------------
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
