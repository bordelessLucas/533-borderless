{
  "name": "socio247",
  "version": "0.0.0",
  "private": true,
  "description": "Sócio247™ — plataforma de agendamento, recorrência e faturamento para profissionais e pequenos negócios.",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/professional",
    "apps/mobile",
    "packages/*",
    "functions"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:professional": "npm run dev -w @socio247/professional",
    "dev:mobile": "npm run start -w @socio247/mobile -- --clear",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "build:functions": "npm run build -w @socio247/functions"
  },
  "dependencies": {
    "expo-font": "14.0.12",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "2.28.0",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.5.0",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-screens": "4.16.0",
    "react-native-safe-area-context": "5.6.2",
    "react-native-gesture-handler": "2.28.0",
    "expo-font": "14.0.12",
    "@expo/vector-icons": {
      "expo-font": "14.0.12"
    }
  }
}
