rules_version = '2';

// Sócio247 — list queries exigem rules SEM get()/exists() (allow list separado de allow get).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isSignedIn() && request.auth.token.platformRole == 'platform_admin';
    }

    function isPlatformStaff() {
      return isSignedIn() &&
        (request.auth.token.platformRole == 'platform_admin' ||
         request.auth.token.platformRole == 'platform_support');
    }

    function workspaceData(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
    }

    function isWorkspaceOwner(workspaceId) {
      return isSignedIn() && workspaceData(workspaceId).ownerId == request.auth.uid;
    }

    function isMemberDoc(workspaceId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function canAccessWorkspace(workspaceId) {
      return isPlatformStaff() || isWorkspaceOwner(workspaceId) || isMemberDoc(workspaceId);
    }

    function isLegacyTenantOwnerGet(workspaceId) {
      return isSignedIn()
        && !('ownerId' in resource.data)
        && workspaceData(workspaceId).ownerId == request.auth.uid;
    }

    function isLegacyTenantOwnerUpdate(workspaceId) {
      return isSignedIn()
        && !('ownerId' in resource.data)
        && workspaceData(workspaceId).ownerId == request.auth.uid;
    }

    function isTenantOwnerDoc() {
      return isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    function isWorkspaceStaffFromToken(workspaceId) {
      return isSignedIn()
        && 'workspaces' in request.auth.token
        && request.auth.token.workspaces.get(workspaceId, '') in ['workspace_owner', 'workspace_staff'];
    }

    function isWorkspaceOwnerByPath(workspaceId) {
      return isSignedIn() && workspaceData(workspaceId).ownerId == request.auth.uid;
    }

    function isTenantOwnerCreate() {
      return isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.workspaceStatus == 'active';
    }

    function isPublicTenantList() {
      return resource.data.workspaceStatus == 'active';
    }

    function isPublicBookingAppointmentCreate(workspaceId) {
      return request.resource.data.workspaceId == workspaceId
        && request.resource.data.source == 'booking_link'
        && request.resource.data.status in ['confirmed', 'pending']
        && request.resource.data.ownerId == workspaceData(workspaceId).ownerId
        && request.resource.data.workspaceStatus == 'active';
    }

    function isPublicBookingClientCreate(workspaceId) {
      return request.resource.data.workspaceId == workspaceId
        && request.resource.data.consentToContact == true
        && request.resource.data.active == true
        && request.resource.data.ownerId == workspaceData(workspaceId).ownerId
        && request.resource.data.workspaceStatus == 'active';
    }

    match /platformAdmins/{uid} {
      allow read: if isPlatformStaff();
      allow write: if isPlatformAdmin();
    }

    match /users/{uid} {
      allow read: if isPlatformStaff() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn() && request.auth.uid == uid
        && !('platformRole' in request.resource.data);
      allow update: if isSignedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['platformRole', 'uid', 'createdAt']);
      allow delete: if isPlatformAdmin();
    }

    match /workspaces/{workspaceId} {
      allow get: if (isSignedIn() && resource.data.ownerId == request.auth.uid)
        || canAccessWorkspace(workspaceId)
        || resource.data.status == 'active';
      allow list: if (isSignedIn() && resource.data.ownerId == request.auth.uid)
        || resource.data.status == 'active';
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.id == workspaceId;
      allow update: if isPlatformAdmin() || isWorkspaceOwner(workspaceId);
      allow delete: if isPlatformAdmin();

      match /members/{memberId} {
        allow get: if canAccessWorkspace(workspaceId)
          || (isSignedIn() && memberId == request.auth.uid);
        allow list: if canAccessWorkspace(workspaceId);
        allow create: if isSignedIn()
          && memberId == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.workspaceId == workspaceId
          && workspaceData(workspaceId).ownerId == request.auth.uid;
        allow update, delete: if isPlatformAdmin() || isWorkspaceOwner(workspaceId);
      }

      match /services/{serviceId} {
        allow get: if isTenantOwnerDoc()
          || isLegacyTenantOwnerGet(workspaceId)
          || isWorkspaceStaffFromToken(workspaceId);
        allow get: if isPublicTenantList() && resource.data.active == true;
        allow list: if isTenantOwnerDoc() || isWorkspaceStaffFromToken(workspaceId);
        allow list: if isPublicTenantList() && resource.data.active == true;
        allow create: if isTenantOwnerCreate()
          && request.resource.data.workspaceId == workspaceId;
        allow update: if isTenantOwnerDoc()
          || isLegacyTenantOwnerUpdate(workspaceId)
          || isWorkspaceOwnerByPath(workspaceId);
        allow delete: if isTenantOwnerDoc()
          || isLegacyTenantOwnerGet(workspaceId)
          || isWorkspaceOwnerByPath(workspaceId);
      }

      match /clients/{clientId} {
        allow get: if isTenantOwnerDoc()
          || isLegacyTenantOwnerGet(workspaceId)
          || isWorkspaceStaffFromToken(workspaceId);
        allow list: if isTenantOwnerDoc() || isWorkspaceStaffFromToken(workspaceId);
        allow create: if (isTenantOwnerCreate()
            && request.resource.data.workspaceId == workspaceId)
          || isPublicBookingClientCreate(workspaceId);
        allow update: if isTenantOwnerDoc()
          || isLegacyTenantOwnerUpdate(workspaceId)
          || isWorkspaceOwnerByPath(workspaceId);
        allow delete: if isTenantOwnerDoc()
          || isLegacyTenantOwnerGet(workspaceId)
          || isWorkspaceOwnerByPath(workspaceId);
      }

      match /appointments/{appointmentId} {
        allow get: if isTenantOwnerDoc()
          || isLegacyTenantOwnerGet(workspaceId)
          || isWorkspaceStaffFromToken(workspaceId);
        allow get: if isPublicTenantList();
        allow list: if isTenantOwnerDoc() || isWorkspaceStaffFromToken(workspaceId);
        allow list: if isPublicTenantList();
        allow create: if (isTenantOwnerCreate()
            && request.resource.data.workspaceId == workspaceId)
          || isPublicBookingAppointmentCreate(workspaceId);
        allow update: if isTenantOwnerDoc()
          || isLegacyTenantOwnerUpdate(workspaceId)
          || isWorkspaceOwnerByPath(workspaceId);
        allow delete: if isTenantOwnerDoc()
          || isLegacyTenantOwnerGet(workspaceId)
          || isWorkspaceOwnerByPath(workspaceId);
      }

      match /availability/{providerId} {
        allow get: if isTenantOwnerDoc()
          || isLegacyTenantOwnerGet(workspaceId)
          || isWorkspaceStaffFromToken(workspaceId);
        allow get: if isPublicTenantList();
        allow list: if isTenantOwnerDoc() || isWorkspaceStaffFromToken(workspaceId);
        allow list: if isPublicTenantList();
        allow create: if isTenantOwnerCreate()
          && request.resource.data.workspaceId == workspaceId;
        allow update: if isTenantOwnerDoc()
          || isLegacyTenantOwnerUpdate(workspaceId)
          || isWorkspaceOwnerByPath(workspaceId);
        allow delete: if isTenantOwnerDoc()
          || isLegacyTenantOwnerGet(workspaceId)
          || isWorkspaceOwnerByPath(workspaceId);
      }

      match /timeBlocks/{blockId} {
        allow get: if isTenantOwnerDoc()
          || isLegacyTenantOwnerGet(workspaceId)
          || isWorkspaceStaffFromToken(workspaceId);
        allow get: if isPublicTenantList();
        allow list: if isTenantOwnerDoc() || isWorkspaceStaffFromToken(workspaceId);
        allow list: if isPublicTenantList();
        allow create: if isTenantOwnerCreate()
          && request.resource.data.workspaceId == workspaceId;
        allow update: if isTenantOwnerDoc()
          || isLegacyTenantOwnerUpdate(workspaceId)
          || isWorkspaceOwnerByPath(workspaceId);
        allow delete: if isTenantOwnerDoc()
          || isLegacyTenantOwnerGet(workspaceId)
          || isWorkspaceOwnerByPath(workspaceId);
      }

      match /notifications/{notificationId} {
        allow get: if isTenantOwnerDoc()
          || isLegacyTenantOwnerGet(workspaceId)
          || isWorkspaceStaffFromToken(workspaceId);
        allow list: if isTenantOwnerDoc() || isWorkspaceStaffFromToken(workspaceId);
        allow create: if isTenantOwnerCreate()
          && request.resource.data.workspaceId == workspaceId;
        allow update: if isTenantOwnerDoc()
          || isLegacyTenantOwnerUpdate(workspaceId)
          || isWorkspaceOwnerByPath(workspaceId);
        allow delete: if isTenantOwnerDoc()
          || isLegacyTenantOwnerGet(workspaceId)
          || isWorkspaceOwnerByPath(workspaceId);
      }

      match /deviceTokens/{tokenId} {
        allow get: if isTenantOwnerDoc()
          || isLegacyTenantOwnerGet(workspaceId)
          || isWorkspaceStaffFromToken(workspaceId);
        allow list: if isTenantOwnerDoc() || isWorkspaceStaffFromToken(workspaceId);
        allow create: if isTenantOwnerCreate()
          && request.resource.data.workspaceId == workspaceId;
        allow update: if isTenantOwnerDoc()
          || isLegacyTenantOwnerUpdate(workspaceId)
          || isWorkspaceOwnerByPath(workspaceId);
        allow delete: if isTenantOwnerDoc()
          || isLegacyTenantOwnerGet(workspaceId)
          || isWorkspaceOwnerByPath(workspaceId);
      }

      match /dailySummaries/{date} {
        allow get: if isTenantOwnerDoc()
          || isLegacyTenantOwnerGet(workspaceId)
          || isWorkspaceStaffFromToken(workspaceId);
        allow list: if isTenantOwnerDoc() || isWorkspaceStaffFromToken(workspaceId);
        allow create: if isTenantOwnerCreate()
          && request.resource.data.workspaceId == workspaceId;
        allow update: if isTenantOwnerDoc()
          || isLegacyTenantOwnerUpdate(workspaceId)
          || isWorkspaceOwnerByPath(workspaceId);
        allow delete: if isTenantOwnerDoc()
          || isLegacyTenantOwnerGet(workspaceId)
          || isWorkspaceOwnerByPath(workspaceId);
      }
    }

    match /subscriptions/{workspaceId} {
      allow read: if isPlatformStaff() || isWorkspaceOwner(workspaceId);
      allow create: if isWorkspaceOwner(workspaceId)
        && request.resource.data.workspaceId == workspaceId;
      allow update, delete: if false;
    }

    match /webhookEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
